rules_version = '2';
// Paste into Firebase console > Firestore Database > Rules, then Publish.
// Replace the two emails with yours and your wife's, in lowercase.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_EMAIL@example.com', 'WIFE_EMAIL@example.com'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
